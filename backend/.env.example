# =====================================================================
# HR5 Invest — backend environment
# Copy to `.env` and fill in. NEVER commit the real .env file.
# =====================================================================

# --- Market data (Financial Modeling Prep) ---
FMP_API_KEY=your_fmp_key_here

# --- AI providers (at least one recommended; Claude is the default) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Default model ids (override if needed)
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-1.5-pro

# --- Security ---
# 32-byte url-safe base64 key used to encrypt sensitive at-rest data.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- App ---
CORS_ORIGINS=http://localhost:3000
CACHE_TTL_SECONDS=15
LOG_LEVEL=INFO
